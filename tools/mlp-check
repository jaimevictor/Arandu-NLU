#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$ROOT"

export PATH="$ROOT/.tools/rust-1.98.0/bin:$PATH"
export CARGO_HOME="$ROOT/.cargo-home"
export PYTHONDONTWRITEBYTECODE=1

python3 tools/contextual-record.py --fingerprint

./tools/generate-mlp-corpus --check
./tools/check-mlp-package
python3 tools/distribution.py
ruby -rjson -ryaml -e '
  JSON.parse(File.read("custom_components/local_nlu/manifest.json"))
  JSON.parse(File.read("custom_components/local_nlu/strings.json"))
  JSON.parse(File.read("custom_components/local_nlu/translations/en.json"))
  JSON.parse(File.read("custom_components/local_nlu/translations/pt-BR.json"))
  config = YAML.safe_load(File.read("addon/config.yaml"), aliases: false)
  abort "addon config" unless config.fetch("slug") == "ptbr_nlu"
  puts "MLP JSON/YAML PASS"
'
python3 -m compileall -q custom_components/local_nlu tests/mlp
python3 -m unittest discover -s tests/mlp -p 'test_*.py'
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked --offline -- -D warnings
cargo test --workspace --locked --offline
cargo build --workspace --release --locked --offline
ARANDU_NLU_BINARY="$ROOT/target/release/local-nlu" python3 -m unittest discover -s tests/mlp -p 'test_contextual*.py'
./tools/mlp-smoke.py

printf '%s\n' "MLP CHECK PASS"
